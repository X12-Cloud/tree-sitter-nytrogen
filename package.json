{
  "name": "tree-sitter-nytrogen",
  "version": "0.1.3",
  "description": "C-style compiler - built with C++",
  "repository": "https://github.com/x12-cloud/nytrogen",
  "license": "GPL",
  "author": {
    "name": "X_12",
    "email": "lamadasun888@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "nytrogen"
  ],
  "grammars": [
    {
      "name": "nytrogen",
      "camelcase": "Nytrogen",
      "scope": "source.nytrogen",
      "file-types": [
        "ny",
        "nyt"
      ]
    }
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-cli": "^0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
